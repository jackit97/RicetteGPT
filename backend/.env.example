# Backend configuration
# Copy to .env and fill values for local development.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGES_MODEL=gpt-image-1
# 0 = disable (faster), 1 = enable (slower)
OPENAI_GENERATE_DISH_IMAGE=0

# Database
# Leave empty to use JSON file store (backend/data/users.json)
# Example: postgresql://user:pass@localhost:5432/ricettegpt
DATABASE_URL=

# When using Postgres, auto-create tables/indexes at startup.
# Recommended on Render for first deploy.
DB_AUTO_MIGRATE=0
